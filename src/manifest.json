{
  "manifest_version": 3,
  "name": "SimpleTranslator",
  "version": "1.0",
  "description": "A simple translator extension.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://lingva.ml/*"
  ],
  "background": {
    "service_worker": "scripts/background.js"
  },
  "action": {
    "default_popup": "index.html",
    "default_title": "Simple Translator"
  },
  "icons": {
    "16": "icons/icon16.png"
  }
}